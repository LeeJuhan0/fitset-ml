MLFLOW_TRACKING_URI=http://localhost:5001/mlflow
MLFLOW_PROXY_TARGET=http://localhost:5001
MLFLOW_UI_USER=
MLFLOW_UI_PASSWORD=
RAW_DATA_BUCKET=fitset-dataset
MODELS_BUCKET=fitset-models
AWS_REGION=ap-northeast-2
COLLECT_IMU_BUCKET=fitset-collect-imu
COLLECT_VIDEO_BUCKET=fitset-collect-video
COLLECT_LABELED_BUCKET=fitset-collect-labeled
PHASE_MODELS_BUCKET=fitset-phase-models
# 파일 목록 DB. sqlite 파일 경로. EC2 는 볼륨의 sqlite:////data/fitset_ml.db, MySQL 을 쓰려면 mysql+aiomysql://... 로 교체
DATABASE_URL=sqlite+aiosqlite:///./fitset_ml.db
# MediaPipe 포즈 모델 경로. 없으면 워커가 내려받는다
POSE_MODEL_PATH=models/pose_landmarker_full.task
